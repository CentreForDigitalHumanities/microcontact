# Copy to .env and adjust. Compose reads this file for configuration and the app's runtime environment.
APP_PORT=8000
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GMAPIKEY=
# Local development database credentials, shared by the db and app services.
DJANGO_DB_NAME=microcontact
DJANGO_DB_USER=microcontact
DJANGO_DB_PASSWORD=change-me
